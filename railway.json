{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "NODE_OPTIONS='--max-old-space-size=2048' npx tsx examples/complete-workflow.ts",
    "cronSchedule": "0 7 * * 1-5",
    "restartPolicyType": "NEVER"
  }
}
