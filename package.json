{
  "name": "linkedin-jobs-scraper",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node --esm src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "workflow": "ts-node --esm examples/main-workflow.ts",
    "scraping": "ts-node --esm examples/scraping-only.ts",
    "complete": "npx tsx examples/complete-workflow.ts",
    "resume": "npx tsx examples/resume-from-jobs.ts"
  },
  "keywords": [
    "linkedin",
    "jobs",
    "scraper",
    "apify",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "description": "TypeScript client for LinkedIn Jobs Scraper API",
  "dependencies": {
    "@types/node": "^25.8.0",
    "axios": "^1.16.1",
    "dotenv": "^17.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@tsconfig/node18": "^18.2.6"
  }
}
